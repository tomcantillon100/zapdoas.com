<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="ZAPDOAS - projects, ideas and updates.">

<style>
:root {
  --bg: #080b12;
  --panel: #111723;
  --panel-soft: #151e2c;
  --text: #f4f7fb;
  --muted: #9aa8bb;
  --accent: #83f7b2;
  --accent-2: #7b9cff;
  --line: rgba(255,255,255,.09);
  --radius: 22px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  color: var(--text);
  background: var(--bg);
  font-family: Inter, Arial, sans-serif;
  line-height: 1.6;
}

body.light {
  --bg: #f4f7fb;
  --panel: #fff;
  --panel-soft: #eaf0f8;
  --text: #101725;
  --muted: #58677d;
  --line: rgba(15,25,40,.12);
}

a {
  color: inherit;
  text-decoration: none;
}

.wrap {
  width: min(1120px, calc(100% - 40px));
  margin: auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(18px);
  background: var(--bg);
  border-bottom: 1px solid var(--line);
}

nav {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  font-weight: 900;
  letter-spacing: .12em;
  font-size: 1.2rem;
}

.brand span { color: var(--accent); }

.navlinks {
  display: flex;
  gap: 25px;
  color: var(--muted);
  font-size: .92rem;
}

.navlinks a:hover { color: var(--accent); }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 12px 18px;
  background: var(--panel);
  color: var(--text);
  font-weight: 700;
  cursor: pointer;
  transition: .2s;
}

.btn:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
}

.btn.primary {
  background: var(--accent);
  color: #07120c;
  border-color: transparent;
}

.hero {
  padding: 95px 0 76px;
  position: relative;
  overflow: hidden;
}

.hero:before {
  content: "";
  position: absolute;
  width: 600px;
  height: 600px;
  right: -180px;
  top: -260px;
  background: radial-gradient(circle, rgba(131,247,178,.15), transparent 68%);
  pointer-events: none;
}

.eyebrow {
  color: var(--accent);
  font-weight: 800;
  letter-spacing: .16em;
  text-transform: uppercase;
  font-size: .78rem;
}

h1 {
  font-size: clamp(3rem, 8vw, 6.4rem);
  line-height: .98;
  letter-spacing: -.06em;
  margin: 18px 0;
}

h1 .gradient {
  background: linear-gradient(100deg, var(--accent), var(--accent-2));
  color: transparent;
  background-clip: text;
}

.hero p {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.12rem;
  margin: 24px 0 30px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.statusline {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  margin-top: 42px;
  font-size: .88rem;
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 16px var(--accent);
}

section { padding: 65px 0; }

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 28px;
}

h2 {
  font-size: clamp(1.8rem, 4vw, 2.7rem);
  line-height: 1.1;
  margin: 8px 0;
}

.section-head p {
  color: var(--muted);
  max-width: 470px;
}

.countdown {
  background: linear-gradient(135deg, var(--panel), rgba(123,156,255,.10));
  border: 1px solid var(--line);
  border-radius: 30px;
  padding: clamp(25px, 5vw, 52px);
  position: relative;
  overflow: hidden;
}

.count-title {
  font-size: clamp(2rem, 5vw, 4rem);
  font-weight: 950;
  margin: 8px 0 5px;
}

.count-title span { color: var(--accent); }

.count-sub {
  color: var(--muted);
  margin-bottom: 28px;
}

.timer {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  max-width: 760px;
}

.timebox {
  background: rgba(0,0,0,.18);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 20px 12px;
  text-align: center;
}

.timebox strong {
  display: block;
  font-size: clamp(2rem, 5vw, 3.5rem);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.timebox small {
  display: block;
  margin-top: 10px;
  color: var(--muted);
  text-transform: uppercase;
  font-size: .72rem;
}

.count-note {
  color: var(--muted);
  font-size: .85rem;
  margin-top: 22px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 25px;
  transition: .2s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--accent);
}

.card-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: var(--panel-soft);
  color: var(--accent);
  font-size: 1.35rem;
}

.card h3 { margin: 19px 0 8px; }

.card p,
.about-panel p {
  color: var(--muted);
}

.about-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 25px;
}

.about-panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 30px;
}

.mini-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 25px;
}

.stat {
  padding: 17px;
  background: var(--panel-soft);
  border-radius: 15px;
}

.stat b {
  display: block;
  font-size: 1.5rem;
  color: var(--accent);
}

.stat span {
  color: var(--muted);
  font-size: .83rem;
}

.update {
  display: flex;
  gap: 18px;
  padding: 19px 0;
  border-bottom: 1px solid var(--line);
}

.update:last-child { border-bottom: 0; }

.update-date {
  min-width: 76px;
  color: var(--accent);
  font-size: .8rem;
  font-weight: 800;
}

.update p {
  color: var(--muted);
  margin: 4px 0 0;
}

.contact-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  padding: 35px;
  border-radius: 28px;
  background: var(--panel);
  border: 1px solid var(--line);
}

.contact-box p { color: var(--muted); }

footer {
  padding: 28px 0 40px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: .85rem;
}

.footer-row {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
}

.settings {
  position: fixed;
  z-index: 30;
  right: 18px;
  bottom: 80px;
  width: min(330px, calc(100% - 36px));
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 18px;
  box-shadow: 0 20px 70px rgba(0,0,0,.35);
  display: none;
}

.settings.open { display: block; }

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  color: var(--muted);
}

.settings select {
  background: var(--panel-soft);
  color: var(--text);
  border: 1px solid var(--line);
  padding: 7px;
  border-radius: 8px;
}

.music-player {
  position: fixed;
  left: 18px;
  bottom: 18px;
  z-index: 25;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel);
  box-shadow: 0 12px 35px rgba(0,0,0,.25);
}

.music-label {
  color: var(--accent);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .1em;
}

.music-btn {
  padding: 8px 13px;
  font-size: .82rem;
}

@media (max-width: 780px) {
  .navlinks { display: none; }
  .hero { padding-top: 70px; }
  .cards, .about-grid { grid-template-columns: 1fr; }
  .section-head, .contact-box {
    align-items: start;
    flex-direction: column;
  }
}

@media (max-width: 480px) {
  .timer { gap: 7px; }
  .timebox { padding: 16px 5px; }
  .timebox small { font-size: .6rem; }
  .countdown { padding: 22px 15px; }
  .hero-actions .btn { width: 100%; }
  .music-player { left: 10px; bottom: 10px; padding: 8px; }
  .music-label { display: none; }
}
</style>
</head>

<body>

<header class="topbar">
  <div class="wrap">
    <nav>
      <a class="brand" href="#home">ZAP<span>DOAS</span></a>

      <div class="navlinks">
        <a href="#countdown">SUIN DAY</a>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#updates">Updates</a>
      </div>

      <button class="btn" id="settingsButton">⚙ Customise</button>
    </nav>
  </div>
</header>

<main>

<section class="hero" id="home">
  <div class="wrap">
    <div class="eyebrow">WELCOME TO ZAPDOAS.COM</div>

    <h1>Ideas become<br>
      <span class="gradient">something real.</span>
    </h1>

    <p>
      A home for cool projects, fresh ideas and things worth
      checking out. Explore what’s happening and keep an eye
      on the countdown to SUIN DAY.
    </p>

    <div class="hero-actions">
      <a class="btn primary" href="#countdown">See countdown ↗</a>
      <a class="btn" href="#projects">Explore the site</a>
    </div>

    <div class="statusline">
      <span class="dot"></span>
      A little corner of the internet, built with ideas.
    </div>
  </div>
</section>

<section id="countdown">
  <div class="wrap">
    <div class="countdown">
      <div class="eyebrow">THE DATE IS SET</div>

      <div class="count-title">GOON <span>TO SUIN</span></div>

      <p class="count-sub">The countdown is on. Goon to SUIN!</p>

      <div class="timer" aria-live="polite">
        <div class="timebox"><strong id="days">000</strong><small>Days</small></div>
        <div class="timebox"><strong id="hours">00</strong><small>Hours</small></div>
        <div class="timebox"><strong id="minutes">00</strong><small>Minutes</small></div>
        <div class="timebox"><strong id="seconds">00</strong><small>Seconds</small></div>
      </div>

      <div class="count-note" id="countMessage">
        Counting down to June 6, 2027
      </div>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">WHAT IS ZAPDOAS?</div>
        <h2>A place for your ideas.</h2>
      </div>
      <p>Use this section to tell visitors what your website is about.</p>
    </div>

    <div class="about-grid">
      <div class="about-panel">
        <h3>Welcome to the site</h3>
        <p>
          ZAPDOAS is where projects, experiments and updates
          come together. There’s always more to discover.
        </p>
        <p>Replace this text with your own description.</p>

        <div class="mini-stats">
          <div class="stat"><b>01</b><span>Your first big idea</span></div>
          <div class="stat"><b>∞</b><span>More things to create</span></div>
        </div>
      </div>

      <div class="about-panel">
        <div class="eyebrow">THE VIBE</div>
        <h3>Curious. Creative. Always building.</h3>
        <p>A space for sharing projects and giving people a reason to come back.</p>
        <a class="btn" href="#updates">See what's new ↓</a>
      </div>
    </div>
  </div>
</section>

<section id="projects">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">FEATURED</div>
        <h2>Things to explore.</h2>
      </div>
      <p>Change these cards to your real projects, games or ideas.</p>
    </div>

    <div class="cards">
      <article class="card">
        <div class="card-icon">✦</div>
        <h3>Latest Project</h3>
        <p>Show visitors your newest creation here.</p>
      </article>

      <article class="card">
        <div class="card-icon">⌘</div>
        <h3>Experiments</h3>
        <p>Interesting things you’re testing or building.</p>
      </article>

      <article class="card">
        <div class="card-icon">↗</div>
        <h3>Coming Soon</h3>
        <p>Give visitors something to look forward to.</p>
      </article>
    </div>
  </div>
</section>

<section id="updates">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">THE LATEST</div>
        <h2>Updates & news.</h2>
      </div>
      <p>Keep this area updated whenever you add something new.</p>
    </div>

    <div class="about-panel">
      <div class="update">
        <div class="update-date">NOW</div>
        <div>
          <strong>The website is live</strong>
          <p>ZAPDOAS has a new homepage.</p>
        </div>
      </div>

      <div class="update">
        <div class="update-date">SOON</div>
        <div>
          <strong>More things are on the way</strong>
          <p>Check back for new projects and SUIN updates.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="contact">
  <div class="wrap">
    <div class="contact-box">
      <div>
        <div class="eyebrow">SAY HELLO</div>
        <h2>Got an idea?</h2>
        <p>Add your email or social links here.</p>
      </div>

      <!-- Change this email to your real contact address -->
      <a class="btn primary" href="mailto:hello@zapdoas.com">Contact ↗</a>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap footer-row">
    <span>© <span id="year"></span> ZAPDOAS. Made with ideas.</span>
    <a href="#home">Back to top ↑</a>
  </div>
</footer>

<!-- MUSIC PLAYER -->
<div class="music-player">
  <span class="music-label">♫ SUIN SOUND</span>
  <button class="btn music-btn" id="musicButton">▶ Play music</button>
</div>

<!-- CUSTOMISATION MENU -->
<aside class="settings" id="settingsPanel">
  <h3>Homepage settings</h3>

  <div class="setting-row">
    <label for="accentPicker">Accent colour</label>
    <input type="color" id="accentPicker" value="#83f7b2">
  </div>

  <div class="setting-row">
    <label for="themePicker">Theme</label>
    <select id="themePicker">
      <option value="dark">Dark</option>
      <option value="light">Light</option>
    </select>
  </div>

  <div class="setting-row">
    <label for="projectsToggle">Show projects</label>
    <input type="checkbox" id="projectsToggle" checked>
  </div>

  <div class="setting-row">
    <label for="updatesToggle">Show updates</label>
    <input type="checkbox" id="updatesToggle" checked>
  </div>

  <button class="btn" id="closeSettings">Close settings</button>
</aside>

<script>
// COUNTDOWN TO JUNE 6, 2027
// JavaScript months start at zero, so June is 5.
const targetDate = new Date(2027, 5, 6, 0, 0, 0);
const $ = id => document.getElementById(id);

function updateCountdown() {
  const difference = targetDate.getTime() - Date.now();

  if (difference <= 0) {
    $("days").textContent = "000";
    $("hours").textContent = "00";
    $("minutes").textContent = "00";
    $("seconds").textContent = "00";
    $("countMessage").textContent = "GOON TO SUIN! 🎉";
    return;
  }

  const total = Math.floor(difference / 1000);

  $("days").textContent =
    String(Math.floor(total / 86400)).padStart(3, "0");

  $("hours").textContent =
    String(Math.floor((total % 86400) / 3600)).padStart(2, "0");

  $("minutes").textContent =
    String(Math.floor((total % 3600) / 60)).padStart(2, "0");

  $("seconds").textContent =
    String(total % 60).padStart(2, "0");
}

updateCountdown();
setInterval(updateCountdown, 1000);
$("year").textContent = new Date().getFullYear();

// SETTINGS MENU
const settingsPanel = $("settingsPanel");

$("settingsButton").addEventListener("click", () => {
  settingsPanel.classList.toggle("open");
});

$("closeSettings").addEventListener("click", () => {
  settingsPanel.classList.remove("open");
});

// ACCENT COLOUR
$("accentPicker").addEventListener("input", event => {
  document.documentElement.style.setProperty(
    "--accent",
    event.target.value
  );
});

// DARK / LIGHT THEME
$("themePicker").addEventListener("change", event => {
  document.body.classList.toggle(
    "light",
    event.target.value === "light"
  );
});

// SHOW / HIDE SECTIONS
$("projectsToggle").addEventListener("change", event => {
  $("projects").hidden = !event.target.checked;
});

$("updatesToggle").addEventListener("change", event => {
  $("updates").hidden = !event.target.checked;
});

// ORIGINAL SYNTH MUSIC - NO EXTRA FILE REQUIRED
let audioContext;
let musicPlaying = false;
let musicTimer;
let noteIndex = 0;

const melody = [
  261.63, 329.63, 392, 523.25,
  392, 329.63, 293.66, 349.23
];

function playNote() {
  if (!musicPlaying || !audioContext) return;

  const now = audioContext.currentTime;
  const oscillator = audioContext.createOscillator();
  const volume = audioContext.createGain();

  oscillator.type = "sine";
  oscillator.frequency.value =
    melody[noteIndex % melody.length];

  volume.gain.setValueAtTime(0.0001, now);
  volume.gain.exponentialRampToValueAtTime(0.07, now + 0.08);
  volume.gain.exponentialRampToValueAtTime(0.0001, now + 1.6);

  oscillator.connect(volume);
  volume.connect(audioContext.destination);

  oscillator.start(now);
  oscillator.stop(now + 1.7);

  noteIndex++;
  musicTimer = setTimeout(playNote, 1750);
}

$("musicButton").addEventListener("click", async () => {
  const button = $("musicButton");

  if (!musicPlaying) {
    audioContext = audioContext ||
      new (window.AudioContext || window.webkitAudioContext)();

    await audioContext.resume();

    musicPlaying = true;
    button.textContent = "❚❚ Pause music";
    playNote();
  } else {
    musicPlaying = false;
    clearTimeout(musicTimer);

    await audioContext.suspend();

    button.textContent = "▶ Play music";
  }
});
</script>

</body>
</html>
